# 复制为 .env 后填写真实值，切勿提交到仓库。

# JWT 签名密钥（必填）。未设置时服务会使用进程随机密钥，重启即掉登录态；
# LINGXIA_ENV=production 时未设置将直接拒绝启动。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 运行环境：production 会启用启动强校验
LINGXIA_ENV=production

# 前端站点地址，用于支付完成后的同步回跳
FRONTEND_URL=https://xingx.shop

# 后端公网地址（含协议），用于生成支付 notify_url / return_url。
# 配置后不再依据请求 Host 头生成回调地址，公网部署强烈建议填写。示例：https://api.xingx.shop
PUBLIC_BASE_URL=

# 部署在 Cloudflare / Nginx 等反向代理之后且源站不直接暴露时设为 true，
# 限流才会读取 CF-Connecting-IP / X-Forwarded-For 等转发头；默认 false 使用直连 IP。
TRUST_PROXY_HEADERS=false

# 可选：首次初始化数据库时的管理员密码。留空则自动生成随机密码并打印到日志。
ADMIN_INITIAL_PASSWORD=
